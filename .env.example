APP_NAME=Hue Session
APP_AUTHOR=levensailor
APP_HOST=127.0.0.1
APP_PORT=8742
APP_DEVICE_NAME=mac

LOG_DIR=logs
LOG_FILE_NAME=hue-session.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3
LOG_LEVEL=INFO

DATA_DIR=data
SETTINGS_FILE_NAME=settings.json
CREDENTIALS_FILE_NAME=credentials.json

HUE_DISCOVERY_URL=https://discovery.meethue.com/
HUE_DISCOVERY_TIMEOUT_SECONDS=4
HUE_MDNS_TIMEOUT_SECONDS=5
HUE_PAIR_DEVICE_TYPE=hue-session#mac
HUE_STREAM_IDLE_TIMEOUT_SECONDS=60
HUE_STREAM_HZ=40

AUDIO_BLOCK_SIZE=2048
AUDIO_PREFERRED_SAMPLE_RATE=48000
AUDIO_SSL_NAME_HINTS=SSL,Solid State Logic

SHOW_DEFAULT_MODE=spectrum
SHOW_DEFAULT_SENSITIVITY=1.0
SHOW_DEFAULT_BRIGHTNESS=0.85
SHOW_DEFAULT_SATURATION=0.95
